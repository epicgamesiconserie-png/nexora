generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  usernameNorm String    @unique @map("username_norm")
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String    @default("user") @map("role")
  isPremium    Boolean   @default(false) @map("is_premium")
  premiumUntil DateTime? @map("premium_until")
  createdAt    DateTime  @default(now()) @map("created_at")

  profile        Profile?
  links          Link[]
  socials        Social[]
  sessions       Session[]
  passwordResets PasswordReset[]
  music          Music?
  premiumCodes   PremiumCode[]   @relation("PremiumCodeCreator")
  usedCodes      PremiumCode[]   @relation("PremiumCodeUser")

  @@map("users")
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique @map("user_id")
  displayName        String?  @map("display_name")
  bio                String?  @db.Text
  avatarUrl          String?  @map("avatar_url")
  avatarStyle        String   @default("circle") @map("avatar_style")
  backgroundUrl      String?  @map("background_url")
  backgroundVideoUrl String?  @map("background_video_url")
  backgroundType     String   @default("gradient") @map("background_type")
  backgroundColor    String   @default("#0a0a0a") @map("background_color")
  backgroundGradient String   @default("linear-gradient(160deg,#0a0a0a,#14141a)") @map("background_gradient")
  accentColor        String   @default("#a855f7") @map("accent_color")
  textColor          String   @default("#ffffff") @map("text_color")
  font               String   @default("Inter") @map("font")
  buttonStyle        String   @default("solid") @map("button_style")
  borderRadius       Int      @default(16) @map("border_radius")
  blur               Int      @default(12) @map("blur")
  effect             String   @default("none") @map("effect")
  showViewCount      Boolean  @default(true) @map("show_view_count")
  views              Int      @default(0)
  badges             String[] @default([])
  unlockedBadges     String[] @default([]) @map("unlocked_badges")
  hiddenBadges       String[] @default([]) @map("hidden_badges")
  audioUrl           String?  @map("audio_url")
  audioTitle         String?  @map("audio_title")
  audioArtist        String?  @map("audio_artist")
  cursorUrl          String?  @map("cursor_url")
  location           String?  @map("location")
  profileOpacity     Int      @default(100) @map("profile_opacity")
  monochromeIcons    Boolean  @default(false) @map("monochrome_icons")
  animatedTitle      Boolean  @default(false) @map("animated_title")
  animatedTitleStyle String   @default("none") @map("animated_title_style")
  swapBoxColors      Boolean  @default(false) @map("swap_box_colors")
  volumeControl      Boolean  @default(false) @map("volume_control")
  mouseTrail         String   @default("none") @map("mouse_trail")
  welcomeEnabled     Boolean  @default(false) @map("welcome_enabled")
  welcomeText        String?  @map("welcome_text")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Link {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  title     String
  url       String
  icon      String?
  enabled   Boolean  @default(true)
  position  Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@map("links")
}

model Social {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  platform String
  url      String
  position Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("socials")
}

model Music {
  id         String  @id @default(cuid())
  userId     String  @unique @map("user_id")
  url        String?
  title      String?
  artist     String?
  autoplay   Boolean @default(false)
  volume     Int     @default(60)
  loop       Boolean @default(true)
  showPlayer Boolean @default(true) @map("show_player")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("music")
}

model Analytics {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  linkId    String?  @map("link_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("analytics")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model PremiumCode {
  id          String    @id @default(cuid())
  code        String    @unique
  duration    Int       @default(30) @map("duration_days")
  createdById String    @map("created_by_id")
  usedById    String?   @map("used_by_id")
  usedAt      DateTime? @map("used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("PremiumCodeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("PremiumCodeUser", fields: [usedById], references: [id], onDelete: SetNull)

  @@map("premium_codes")
}
